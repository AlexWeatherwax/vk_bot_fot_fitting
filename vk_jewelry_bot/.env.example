# Скопируйте этот файл в .env и заполните своими значениями.
# Сам .env НЕ должен попадать в git / публичные места — в нём секретный токен.

# Токен сообщества ВК (Управление сообществом -> Работа с API -> Создать ключ),
# нужны права: photos, docs, messages (управление сообществом должно быть включено).
VK_TOKEN=

# ID сообщества (число, без минуса). Посмотреть можно в Управление сообществом -> Информация.
VK_GROUP_ID=

# Необязательно: уровень логов (DEBUG/INFO/WARNING)
LOG_LEVEL=INFO

# Необязательно: папка для временных файлов (по умолчанию ./data/tmp)
TMP_DIR=

# Optional automatic ear detection; see docs/AUTOMATIC_EARRINGS.md
# EAR_PARSER_BACKEND=grounded-sam2
# EAR_PARSER_MODEL=data/models/ear-grounded
